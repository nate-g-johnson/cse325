###

# POST -> 201 Created, body is the new pizza (id 6), Location: /Pizza/6
POST {{ContosoPizza_HostAddress}}/pizza/
Content-Type: application/json

{
    "name": "Margherita",
    "isGlutenFree": false
}

###

# GET one -> 200 OK, {"id":6,"name":"Margherita","isGlutenFree":false}
GET {{ContosoPizza_HostAddress}}/pizza/6
Accept: application/json

###

# PUT -> 204 No Content (empty body)
PUT {{ContosoPizza_HostAddress}}/pizza/6
Content-Type: application/json

{
    "id": 6,
    "name": "Margherita GF",
    "isGlutenFree": true
}

###

# DELETE -> 204 No Content (empty body); a later GET /pizza/6 returns 404 Not Found
DELETE {{ContosoPizza_HostAddress}}/pizza/6

###
